@model QuanLySinhVien.Models.MonHoc
@{
    ViewData["Title"] = "Sửa môn học";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-edit mr-2"></i> Sửa môn học
        </h3>
    </div>

    <form method="post" action="/MonHoc/Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="MaMon" value="@Model.MaMon">

        <div class="card-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle mr-1"></i>
                    <strong>Vui lòng kiểm tra lại:</strong>
                    <ul class="mb-0 mt-1">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Mã môn</label>
                        <input type="text" value="@Model.MaMon" class="form-control"
                               readonly disabled style="background:#e9ecef;cursor:not-allowed;">
                    </div>

                    <div class="form-group">
                        <label>Tên môn học <span class="text-danger">*</span></label>
                        <input type="text" name="TenMon" value="@Model.TenMon"
                               class="form-control" required>
                    </div>

                    <div class="form-group">
                        <label>Khoa <span class="text-danger">*</span></label>
                        <select name="MaKhoa" class="form-control" required>
                            <option value="">-- Chọn khoa --</option>
                            @if (ViewBag.DanhSachKhoa != null)
                            {
                                foreach (var khoa in ViewBag.DanhSachKhoa)
                                {
                                    if (Model.MaKhoa == khoa.MaKhoa)
                                    {
                                        <option value="@khoa.MaKhoa" selected="selected">@khoa.TenKhoa</option>
                                    }
                                    else
                                    {
                                        <option value="@khoa.MaKhoa">@khoa.TenKhoa</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Số tín chỉ <span class="text-danger">*</span></label>
                        <select name="SoTinChi" class="form-control" required>
                            @foreach (var tc in new[] { 1, 2, 3, 4, 5 })
                            {
                                if (Model.SoTinChi == tc)
                                {
                                    <option value="@tc" selected="selected">@tc tín chỉ</option>
                                }
                                else
                                {
                                    <option value="@tc">@tc tín chỉ</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Tỷ lệ điểm (Quá trình - Cuối kỳ) <span class="text-danger">*</span></label>
                        <select id="chonHeSo" class="form-control" onchange="doiHeSo()" required>
                            @if (Model.HeSoQt == 0.40m)
                            {
                                <option value="0.4-0.6" selected="selected">Quá trình 40% - Điểm thi 60%</option>
                            }
                            else
                            {
                                <option value="0.4-0.6">Quá trình 40% - Điểm thi 60%</option>
                            }

                            @if (Model.HeSoQt == 0.30m)
                            {
                                <option value="0.3-0.7" selected="selected">Quá trình 30% - Điểm thi 70%</option>
                            }
                            else
                            {
                                <option value="0.3-0.7">Quá trình 30% - Điểm thi 70%</option>
                            }

                            @if (Model.HeSoQt == 0.50m)
                            {
                                <option value="0.5-0.5" selected="selected">Quá trình 50% - Điểm thi 50%</option>
                            }
                            else
                            {
                                <option value="0.5-0.5">Quá trình 50% - Điểm thi 50%</option>
                            }
                        </select>

                        <input type="hidden" id="HeSoQt" name="HeSoQt" value="@Model.HeSoQt.ToString("0.00")" />
                        <input type="hidden" id="HeSoCk" name="HeSoCk" value="@Model.HeSoCk.ToString("0.00")" />
                    </div>

                    <div class="form-group mt-4">
                        <div class="custom-control custom-checkbox">
                            <input type="checkbox"
                                   class="custom-control-input"
                                   id="IsDieuKien"
                                   name="IsDieuKien"
                                   value="true"
                            @(Model.IsDieuKien ? "checked" : "")>
                            <input type="hidden" name="IsDieuKien" value="false" />
                            <label class="custom-control-label font-weight-bold text-danger" for="IsDieuKien">
                                Đây là môn điều kiện / môn tiên quyết, không tính GPA
                            </label>
                        </div>
                        <small class="text-muted">
                            Môn được tích sẽ có dấu <strong>*</strong> trong bảng điểm, không tính vào GPA hệ 4.
                        </small>
                    </div>
                </div>
            </div>

            <div class="alert alert-info py-2 mt-3">
                <i class="fas fa-info-circle mr-1"></i>
                Hệ thống sẽ tự động sử dụng tỷ lệ hệ số này khi Giảng viên nhập điểm cho môn <strong>@Model.TenMon</strong>.
                <br />
                <strong class="text-danger">(*)</strong> Môn điều kiện / môn tiên quyết sẽ không tính vào GPA hệ 4.
            </div>
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-warning">
                <i class="fas fa-save mr-1"></i> Lưu thay đổi
            </button>
            <a href="/MonHoc/Index" class="btn btn-default ml-2">
                <i class="fas fa-arrow-left mr-1"></i> Quay lại
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        function doiHeSo() {
            var tyLe = document.getElementById('chonHeSo').value.split('-');
            document.getElementById('HeSoQt').value = tyLe[0];
            document.getElementById('HeSoCk').value = tyLe[1];
        }

        document.addEventListener('DOMContentLoaded', function () {
            doiHeSo();
        });
    </script>
}