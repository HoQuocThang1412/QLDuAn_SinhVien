@model QuanLySinhVien.Models.HocKy
@{
    ViewData["Title"] = "Sửa học kỳ";
}
<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-calendar-edit mr-2"></i> Sửa học kỳ
                </h3>
            </div>
            <form method="post" action="/HocKy/Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" name="MaHocKy" value="@Model.MaHocKy">

                <div class="card-body">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle mr-1"></i>
                            <strong>Vui lòng kiểm tra lại:</strong>
                            <ul class="mb-0 mt-1">
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <li>@error.ErrorMessage</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="form-group">
                        <label>Mã học kỳ</label>
                        <input type="text" value="@Model.MaHocKy" class="form-control"
                               readonly disabled style="background:#e9ecef;cursor:not-allowed;">
                        <small class="text-muted">Mã học kỳ không thể thay đổi.</small>
                    </div>

                    <div class="form-group">
                        <label>Tên học kỳ <span class="text-danger">*</span></label>
                        <input type="text" name="TenHocKy" value="@Model.TenHocKy"
                               class="form-control" required>
                    </div>

                    <div class="form-group">
                        <label class="control-label font-weight-bold">Giới hạn tín chỉ tối đa</label>
                        <input type="number"
                               name="GioiHanTinChi"
                               class="form-control text-danger font-weight-bold"
                               value="@(Model?.GioiHanTinChi ?? 25)"
                               min="1"
                               max="50"
                               step="1"
                               required />
                        <small class="form-text text-muted">Số tín chỉ lớn nhất sinh viên được phép đăng ký trong kỳ này.</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Ngày bắt đầu <span class="text-danger">*</span></label>
                                <input type="date" name="NgayBatDau"
                                       value="@Model.NgayBatDau.ToString("yyyy-MM-dd")"
                                       class="form-control" required>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label>Ngày kết thúc <span class="text-danger">*</span></label>
                                <input type="date" name="NgayKetThuc"
                                       value="@Model.NgayKetThuc.ToString("yyyy-MM-dd")"
                                       class="form-control" required>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Trạng thái <span class="text-danger">*</span></label>
                        <select name="TrangThai" class="form-control" required>
                            @foreach (var tt in new[] { "Sắp diễn ra", "Đang diễn ra", "Đã kết thúc" })
                            {
                                if (Model.TrangThai == tt)
                                {
                                    <option value="@tt" selected="selected">@tt</option>
                                }
                                else
                                {
                                    <option value="@tt">@tt</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="card-footer">
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-save mr-1"></i> Lưu thay đổi
                    </button>
                    <a href="/HocKy/Index" class="btn btn-default ml-2">
                        <i class="fas fa-arrow-left mr-1"></i> Quay lại
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>