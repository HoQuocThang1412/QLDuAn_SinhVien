@model IEnumerable<QuanLySinhVien.Models.KhoaHoc>
@{
    ViewData["Title"] = "Quản lý Khóa học";
}

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title font-weight-bold mb-0">
            <i class="fas fa-layer-group mr-1 text-primary"></i> DANH SÁCH KHÓA HỌC
        </h3>
        <a href="/KhoaHoc/Create" class="btn btn-success btn-sm shadow-sm">
            <i class="fas fa-plus"></i> Thêm Khóa
        </a>
    </div>
    <div class="card-body p-0">
        <table class="table table-bordered table-hover text-center mb-0">
            <thead class="bg-primary text-white">
                <tr>
                    <th>Mã Khóa</th>
                    <th>Tên Khóa</th>
                    <th>Năm bắt đầu</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="font-weight-bold text-primary">@item.MaKhoaHoc</td>
                        <td>@item.TenKhoaHoc</td>
                        <td>@(item.NamBatDau?.ToString() ?? "-")</td>
                        <td>
                            <a href="/KhoaHoc/Edit/@item.Id" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i>
                            </a>
                            <form action="/KhoaHoc/Delete/@item.Id" method="post"
                                  class="d-inline" onsubmit="return confirm('Xóa khóa này?')">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-danger btn-sm">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>