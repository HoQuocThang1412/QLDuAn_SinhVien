@model QuanLySinhVien.Models.LopHoc
@{
    ViewData["Title"] = "Chi tiết lớp học";
}

<div class="row">
    <!-- Cột trái -->
    <div class="col-md-4">
        <div class="card card-primary card-outline">
            <div class="card-body box-profile">
                <div class="text-center">
                    <div style="width:80px;height:80px;border-radius:50%;background:#17a2b8;
                                display:inline-flex;align-items:center;justify-content:center;
                                font-size:28px;font-weight:700;color:#fff;margin-bottom:10px;">
                        <i class="fas fa-chalkboard"></i>
                    </div>
                </div>
                <h3 class="profile-username text-center">@Model.TenLop</h3>
                <p class="text-muted text-center">@Model.MaKhoaNavigation?.TenKhoa</p>

                <ul class="list-group list-group-unbordered mb-3">
                    <li class="list-group-item">
                        <b>Mã lớp</b>
                        <span class="float-right"><code>@Model.MaLop</code></span>
                    </li>
                    <li class="list-group-item">
                        <b>Khóa học</b>
                        <span class="float-right">
                            <span class="badge badge-primary">@Model.KhoaHoc</span>
                        </span>
                    </li>
                    <li class="list-group-item">
                        <b>Sĩ số</b>
                        <span class="float-right">
                            <strong>@Model.SinhViens.Count()</strong> sinh viên
                        </span>
                    </li>
                </ul>

                <a href="/LopHoc/Edit/@Model.MaLop" class="btn btn-warning btn-block">
                    <i class="fas fa-edit mr-1"></i> Sửa thông tin
                </a>
                <a href="/LopHoc/Index" class="btn btn-default btn-block mt-2">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>

    <!-- Cột phải: danh sách sinh viên trong lớp -->
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-users mr-2"></i>
                    Danh sách sinh viên — @Model.TenLop
                </h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered table-hover mb-0">
                    <thead class="thead-dark">
                        <tr>
                            <th style="width:120px">MSSV</th>
                            <th>Họ và tên</th>
                            <th style="width:120px">Ngày sinh</th>
                            <th style="width:120px">Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.SinhViens.Any())
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-3">
                                    Chưa có sinh viên nào trong lớp này.
                                </td>
                            </tr>
                        }
                        @foreach (var sv in Model.SinhViens.OrderBy(s => s.HoTen))
                        {
                            <tr>
                                <td><code>@sv.Mssv</code></td>
                                <td>
                                    <a href="/SinhVien/Detail/@sv.Mssv">@sv.HoTen</a>
                                </td>
                                <td>
                                    @if (sv.NgaySinh != null)
                                    {
                                        @sv.NgaySinh.ToString("dd/MM/yyyy")
                                    }
                                </td>
                                <td>
                                    @{
                                        string bc = "badge-secondary";
                                        if (sv.TrangThai == "Đang học") bc = "badge-success";
                                        else if (sv.TrangThai == "Bảo lưu") bc = "badge-warning";
                                        else if (sv.TrangThai == "Thôi học") bc = "badge-danger";
                                        else if (sv.TrangThai == "Đã tốt nghiệp") bc = "badge-info";
                                    }
                                    <span class="badge @bc">@sv.TrangThai</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>