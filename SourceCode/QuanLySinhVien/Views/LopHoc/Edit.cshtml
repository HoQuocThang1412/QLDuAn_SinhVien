@model QuanLySinhVien.Models.LopHoc
@{
    ViewData["Title"] = "Sửa thông tin lớp học";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-edit mr-2"></i> Sửa thông tin lớp học
        </h3>
    </div>

    <form method="post" action="/LopHoc/Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="MaLop" value="@Model.MaLop">

        <div class="card-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle mr-1"></i>
                    <strong>Vui lòng kiểm tra lại:</strong>
                    <ul class="mb-0 mt-1">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Mã lớp</label>
                        <input type="text" value="@Model.MaLop" class="form-control"
                               readonly disabled style="background:#e9ecef;cursor:not-allowed;">
                        <small class="text-muted">Mã lớp không thể thay đổi.</small>
                    </div>
                    <div class="form-group">
                        <label>Tên lớp <span class="text-danger">*</span></label>
                        <input type="text" name="TenLop" value="@Model.TenLop"
                               class="form-control" required>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Khoa <span class="text-danger">*</span></label>
                        <select name="MaKhoa" class="form-control" required>
                            <option value="">-- Chọn khoa --</option>
                            @foreach (var khoa in ViewBag.DanhSachKhoa)
                            {
                                if (Model.MaKhoa == khoa.MaKhoa)
                                {
                                    <option value="@khoa.MaKhoa" selected="selected">@khoa.TenKhoa</option>
                                }
                                else
                                {
                                    <option value="@khoa.MaKhoa">@khoa.TenKhoa</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Khóa học <span class="text-danger">*</span></label>
                        <select name="KhoaHoc" class="form-control" required>
                            <option value="">-- Chọn khóa --</option>
                            @if (ViewBag.DSKhoaHoc != null)
                            {
                                foreach (var kh in ViewBag.DSKhoaHoc)
                                {
                                    <option value="@kh" selected="@(Model.KhoaHoc == kh ? "selected" : null)">
                                        Khóa @kh
                                    </option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-warning">
                <i class="fas fa-save mr-1"></i> Lưu thay đổi
            </button>
            <a href="/LopHoc/Detail/@Model.MaLop" class="btn btn-info ml-2">
                <i class="fas fa-eye mr-1"></i> Xem chi tiết
            </a>
            <a href="/LopHoc/Index" class="btn btn-default ml-2">
                <i class="fas fa-arrow-left mr-1"></i> Quay lại
            </a>
        </div>
    </form>
</div>