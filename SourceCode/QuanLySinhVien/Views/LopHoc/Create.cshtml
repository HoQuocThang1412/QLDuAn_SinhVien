@model QuanLySinhVien.Models.LopHoc
@{
    ViewData["Title"] = "Thêm lớp học mới";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-chalkboard mr-2"></i> Thêm lớp học mới
        </h3>
    </div>

    <form method="post" action="/LopHoc/Create">
        @Html.AntiForgeryToken()
        <div class="card-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle mr-1"></i>
                    <strong>Vui lòng kiểm tra lại:</strong>
                    <ul class="mb-0 mt-1">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Mã lớp <span class="text-danger">*</span></label>
                        <input type="text" name="MaLop" id="maLopInput"
                               value="@Model?.MaLop"
                               class="form-control" placeholder="VD: CNTTK45A-K45"
                               maxlength="20" required>
                        <small class="text-muted">Tối đa 20 ký tự, không thể thay đổi sau khi lưu.</small>
                    </div>
                    <div class="form-group">
                        <label>Tên lớp <span class="text-danger">*</span></label>
                        <input type="text" name="TenLop" id="tenLopInput"
                               value="@Model?.TenLop"
                               class="form-control" placeholder="VD: CNTTK45A - Khóa 45"
                               required>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="form-group">
                        <label>Khoa <span class="text-danger">*</span></label>
                        <select name="MaKhoa" id="selKhoa" class="form-control" required
                                onchange="khoaChanged(this)">
                            <option value="">-- Chọn khoa --</option>
                            @foreach (var khoa in ViewBag.DanhSachKhoa)
                            {
                                <option value="@khoa.MaKhoa">@khoa.TenKhoa</option>
                            }
                        </select>
                    </div>

                    <!-- Chuyên ngành SP -->
                    <div class="form-group" id="divChuyenNganh" style="display:none;">
                        <label>Chuyên ngành Sư phạm <span class="text-danger">*</span></label>
                        <select id="selChuyenNganh" class="form-control"
                                onchange="chuyenNganhChanged(this)">
                            <option value="">-- Chọn chuyên ngành --</option>
                        </select>
                        <small class="text-muted">VD: Sư phạm Toán, Sư phạm Ngữ Văn...</small>
                    </div>

                    <div class="form-group">
                        <label>Khóa học <span class="text-danger">*</span></label>
                        <select name="KhoaHoc" id="khoaHoc" class="form-control" required>
                            <option value="">-- Chọn khóa --</option>
                            @if (ViewBag.DSKhoaHoc != null)
                            {
                                foreach (var kh in ViewBag.DSKhoaHoc)
                                {
                                    <option value="@kh">Khóa @kh</option>
                                }
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save mr-1"></i> Lưu lớp học
            </button>
            <a href="/LopHoc/Index" class="btn btn-default ml-2">
                <i class="fas fa-arrow-left mr-1"></i> Quay lại
            </a>
        </div>
    </form>
</div>