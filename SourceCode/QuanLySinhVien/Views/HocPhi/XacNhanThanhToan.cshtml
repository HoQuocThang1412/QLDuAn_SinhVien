@model QuanLySinhVien.Models.CauHinhQR
@{
    ViewData["Title"] = "Thanh toán học phí trực tuyến";
    string mssv = ViewBag.Mssv;
    string maHocKy = ViewBag.MaHocKy ?? "";
    decimal soTien = ViewBag.SoTien;    // Link QR động từ VietQR
    string qrUrl = $"https://img.vietqr.io/image/{Model.MaNganHang}-{Model.SoTaiKhoan}-compact2.png?amount={soTien}&addInfo=HocPhi_{mssv}&accountName={Model.TenChuTaiKhoan}";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-10 col-lg-8">
            <div class="card card-outline card-success shadow-lg">
                <div class="card-header bg-light">
                    <h3 class="card-title font-weight-bold text-success">
                        <i class="fas fa-qrcode mr-2"></i> XÁC NHẬN CHUYỂN KHOẢN
                    </h3>
                    <div class="card-tools">
                        <span class="badge badge-success px-3 py-2">Chờ thanh toán</span>
                    </div>
                </div>
                
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 border-right">
                            <h5 class="text-navy font-weight-bold mb-4 border-bottom pb-2">THÔNG TIN GIAO DỊCH</h5>
                            <table class="table table-borderless">
                                <tr>
                                    <td class="text-muted" style="width: 40%">Sinh viên:</td>
                                    <td class="font-weight-bold">@mssv</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Ngân hàng:</td>
                                    <td class="font-weight-bold text-primary">@Model.TenNganHang (@Model.MaNganHang)</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Số tài khoản:</td>
                                    <td class="font-weight-bold">
                                        <span id="stk">@Model.SoTaiKhoan</span>
                                        <i class="far fa-copy ml-2 text-muted" style="cursor:pointer" title="Sao chép" onclick="copyToClipboard('@Model.SoTaiKhoan')"></i>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Chủ tài khoản:</td>
                                    <td class="font-weight-bold text-uppercase">@Model.TenChuTaiKhoan</td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Nội dung chuyển:</td>
                                    <td class="font-weight-bold text-danger text-lg">
                                        HocPhi_@mssv
                                    </td>
                                </tr>
                            </table>

                            <div class="callout callout-warning mt-4 shadow-sm bg-light">
                                <h5 class="text-warning font-weight-bold"><i class="fas fa-exclamation-triangle"></i> Lưu ý:</h5>
                                <p class="small mb-0">Hệ thống sẽ cập nhật trạng thái ngay sau khi nhận được tiền. Vui lòng giữ lại biên lai nếu cần đối soát.</p>
                            </div>
                        </div>

                        <div class="col-md-6 text-center d-flex flex-column justify-content-center align-items-center bg-light rounded">
                            <div class="p-3 bg-white border shadow-sm rounded">
                                <img src="@qrUrl" class="img-fluid" style="max-height: 350px;" alt="VietQR" />
                            </div>
                            <h4 class="mt-3 font-weight-bold text-danger">@soTien.ToString("N0") VNĐ</h4>
                            <p class="text-muted small italic">Sử dụng Mobile Banking quét mã để thanh toán nhanh</p>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white p-4">
                    <form asp-action="HoanTatThanhToan" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="soTien" value="@soTien" />
                        <input type="hidden" name="maHocKy" value="@maHocKy" />
                        <div class="row">
                            <div class="col-md-6 mb-2">
                                <a href="@Url.Action("ThongTinHocPhi")" class="btn btn-default btn-block shadow-sm">
                                    <i class="fas fa-arrow-left"></i> QUAY LẠI
                                </a>
                            </div>
                            <div class="col-md-6 mb-2">
                                <button type="submit" class="btn btn-success btn-block shadow font-weight-bold">
                                    <i class="fas fa-check-circle mr-1"></i> TÔI ĐÃ CHUYỂN KHOẢN XONG
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyToClipboard(text) {
            navigator.clipboard.writeText(text);
            alert("Đã sao chép số tài khoản!");
        }
    </script>
}