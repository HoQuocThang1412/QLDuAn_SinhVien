@model QuanLySinhVien.Models.GiangVien
@{
    ViewData["Title"] = "Hồ sơ giảng viên";
}

<div class="row">
    <div class="col-md-4">
        <div class="card card-primary card-outline">
            <div class="card-body box-profile">
                <div class="text-center">
                    <div style="width:80px;height:80px;border-radius:50%;background:#28a745;
                                display:inline-flex;align-items:center;justify-content:center;
                                font-size:28px;font-weight:700;color:#fff;margin-bottom:10px;">
                        @Model.HoTen.Substring(0, 1).ToUpper()
                    </div>
                </div>
                <h3 class="profile-username text-center">@Model.HoTen</h3>
                <p class="text-muted text-center">
                    @if (!string.IsNullOrEmpty(Model.HocVi))
                    {
                        <span class="badge badge-info">@Model.HocVi</span>
                    }
                </p>

                <ul class="list-group list-group-unbordered mb-3">
                    <li class="list-group-item">
                        <b>Mã GV</b>
                        <span class="float-right"><code>@Model.MaGv</code></span>
                    </li>
                    <li class="list-group-item">
                        <b>Khoa</b>
                        <span class="float-right">@Model.MaKhoaNavigation?.TenKhoa</span>
                    </li>
                </ul>

                <a href="/GiangVien/Edit/@Model.MaGv" class="btn btn-warning btn-block">
                    <i class="fas fa-edit mr-1"></i> Sửa thông tin
                </a>
                <a href="/GiangVien/Index" class="btn btn-default btn-block mt-2">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại danh sách
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-id-card mr-2"></i> Thông tin chi tiết
                </h3>
            </div>
            <div class="card-body p-0">
                <table class="table table-bordered mb-0">
                    <tbody>
                        <tr>
                            <th style="width:200px" class="bg-light">Họ và tên</th>
                            <td>@Model.HoTen</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Mã giảng viên</th>
                            <td><code>@Model.MaGv</code></td>
                        </tr>
                        <tr>
                            <th class="bg-light">Học vị</th>
                            <td>
                                @if (!string.IsNullOrEmpty(Model.HocVi))
                                {
                                    <span class="badge badge-info">@Model.HocVi</span>
                                }
                                else
                                {
                                    <span class="text-muted">Chưa cập nhật</span>
                                }
                            </td>
                        </tr>
                        <tr>
                            <th class="bg-light">Khoa</th>
                            <td>@(Model.MaKhoaNavigation?.TenKhoa ?? "Chưa cập nhật")</td>
                        </tr>
                        <tr>
                            <th class="bg-light">Email</th>
                            <td>@(Model.Email ?? "Chưa cập nhật")</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>