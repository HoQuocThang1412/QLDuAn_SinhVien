@model QuanLySinhVien.Models.GiangVien
@{
    ViewData["Title"] = "Sửa thông tin giảng viên";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-user-edit mr-2"></i> Sửa thông tin giảng viên
        </h3>
    </div>

    <form method="post" action="/GiangVien/Edit">
        @Html.AntiForgeryToken()
        <input type="hidden" name="MaGv" value="@Model.MaGv">

        <div class="card-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle mr-1"></i>
                    <strong>Vui lòng kiểm tra lại:</strong>
                    <ul class="mb-0 mt-1">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Mã giảng viên</label>
                        <input type="text" value="@Model.MaGv" class="form-control"
                               readonly disabled style="background:#e9ecef;cursor:not-allowed;">
                        <small class="text-muted">Mã GV không thể thay đổi.</small>
                    </div>
                    <div class="form-group">
                        <label>Họ và tên <span class="text-danger">*</span></label>
                        <input type="text" name="HoTen" value="@Model.HoTen"
                               class="form-control" required>
                    </div>
                    <div class="form-group">
                        <label>Học vị</label>
                        <select name="HocVi" class="form-control">
                            <option value="">-- Chọn học vị --</option>
                            @foreach (var hv in new[] { "Cử nhân", "Thạc sĩ", "Tiến sĩ", "Phó Giáo sư", "Giáo sư" })
                            {
                                if (Model.HocVi == hv)
                                {
                                    <option value="@hv" selected="selected">@hv</option>
                                }
                                else
                                {
                                    <option value="@hv">@hv</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label>Khoa <span class="text-danger">*</span></label>
                        <select name="MaKhoa" class="form-control" required>
                            <option value="">-- Chọn khoa --</option>
                            @foreach (var khoa in ViewBag.DanhSachKhoa)
                            {
                                if (Model.MaKhoa == khoa.MaKhoa)
                                {
                                    <option value="@khoa.MaKhoa" selected="selected">@khoa.TenKhoa</option>
                                }
                                else
                                {
                                    <option value="@khoa.MaKhoa">@khoa.TenKhoa</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input type="email" name="Email" value="@Model.Email"
                               class="form-control" placeholder="example@qnu.edu.vn">
                    </div>
                </div>
            </div>
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-warning">
                <i class="fas fa-save mr-1"></i> Lưu thay đổi
            </button>
            <a href="/GiangVien/Detail/@Model.MaGv" class="btn btn-info ml-2">
                <i class="fas fa-eye mr-1"></i> Xem hồ sơ
            </a>
            <a href="/GiangVien/Index" class="btn btn-default ml-2">
                <i class="fas fa-arrow-left mr-1"></i> Quay lại
            </a>
        </div>
    </form>
</div>