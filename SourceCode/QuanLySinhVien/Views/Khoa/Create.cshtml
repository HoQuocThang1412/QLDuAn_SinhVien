@model QuanLySinhVien.Models.Khoa
@{
    ViewData["Title"] = "Thêm Khoa Mới";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card card-outline card-success shadow-sm">
            <div class="card-header">
                <h3 class="card-title font-weight-bold"><i class="fas fa-plus-circle mr-1 text-success"></i> THÊM KHOA MỚI</h3>
            </div>
            <form asp-action="Create" method="post">
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>
                    
                    <div class="form-group">
                        <label class="font-weight-bold">Mã Khoa <span class="text-danger">*</span></label>
                        <input asp-for="MaKhoa" class="form-control" required placeholder="Ví dụ: CNTT, KTE, TOAN..." maxlength="10" />
                        <span asp-validation-for="MaKhoa" class="text-danger small"></span>
                    </div>
                    
                    <div class="form-group">
                        <label class="font-weight-bold">Tên Khoa <span class="text-danger">*</span></label>
                        <input asp-for="TenKhoa" class="form-control" required placeholder="Ví dụ: Công nghệ Thông tin" />
                        <span asp-validation-for="TenKhoa" class="text-danger small"></span>
                    </div>
                </div>
                <div class="card-footer bg-white text-right">
                    <a href="/Khoa/Index" class="btn btn-default shadow-sm mr-2"><i class="fas fa-arrow-left"></i> Quay lại</a>
                    <button type="submit" class="btn btn-success shadow-sm"><i class="fas fa-save mr-1"></i> Lưu lại</button>
                </div>
            </form>
        </div>
    </div>
</div>