@model QuanLySinhVien.Models.Khoa
@{
    ViewData["Title"] = "Cập Nhật Khoa";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card card-outline card-warning shadow-sm">
            <div class="card-header">
                <h3 class="card-title font-weight-bold"><i class="fas fa-edit mr-1 text-warning"></i> CẬP NHẬT KHOA: @Model.MaKhoa</h3>
            </div>
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="MaKhoa" />
                <div class="card-body">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3 font-weight-bold"></div>
                    
                    <div class="form-group">
                        <label class="font-weight-bold text-muted">Mã Khoa</label>
                        <input value="@Model.MaKhoa" class="form-control bg-light" disabled />
                        <small class="text-muted italic">Mã Khoa là định danh duy nhất, không thể thay đổi.</small>
                    </div>
                    
                    <div class="form-group">
                        <label class="font-weight-bold">Tên Khoa <span class="text-danger">*</span></label>
                        <input asp-for="TenKhoa" class="form-control" required />
                        <span asp-validation-for="TenKhoa" class="text-danger small"></span>
                    </div>
                </div>
                <div class="card-footer bg-white text-right">
                    <a href="/Khoa/Index" class="btn btn-default shadow-sm mr-2"><i class="fas fa-arrow-left"></i> Quay lại</a>
                    <button type="submit" class="btn btn-warning shadow-sm font-weight-bold"><i class="fas fa-save mr-1"></i> Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>