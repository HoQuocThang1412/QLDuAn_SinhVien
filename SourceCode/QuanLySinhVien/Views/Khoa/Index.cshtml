@model IEnumerable<QuanLySinhVien.Models.Khoa>
@{
    ViewData["Title"] = "Quản lý Khoa";
}

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title font-weight-bold mb-0"><i class="fas fa-building mr-1 text-primary"></i> DANH SÁCH CÁC KHOA</h3>
        <a href="/Khoa/Create" class="btn btn-success btn-sm ml-auto shadow-sm"><i class="fas fa-plus"></i> Thêm Khoa Mới</a>
    </div>

    <div class="card-body p-0">
        <table class="table table-bordered table-hover text-center table-striped mb-0">
            <thead class="bg-primary text-white">
                <tr>
                    <th style="width: 25%">Mã Khoa</th>
                    <th class="text-left">Tên Khoa</th>
                    <th style="width: 20%">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="font-weight-bold text-primary align-middle">@item.MaKhoa</td>
                            <td class="text-left align-middle font-weight-bold">@item.TenKhoa</td>
                            <td class="align-middle">
                                <div class="btn-group">
                                    <a href="/Khoa/Edit/@item.MaKhoa" class="btn btn-warning btn-sm" title="Sửa"><i class="fas fa-edit"></i></a>
                                    <form action="/Khoa/Delete/@item.MaKhoa" method="post" class="d-inline m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm rounded-right" title="Xóa" onclick="return confirm('Sếp có chắc chắn muốn xóa Khoa này không?');">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="3" class="text-muted py-4 font-italic">Chưa có dữ liệu khoa nào trong hệ thống.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>