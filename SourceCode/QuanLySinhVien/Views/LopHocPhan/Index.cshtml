@model IEnumerable<QuanLySinhVien.Models.LopHocPhan>
@{
    ViewData["Title"] = "Danh sách lớp học phần";
    string selectedKhoaHoc = ViewBag.KhoaHoc ?? "";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2-bootstrap-theme/0.1.0-beta.10/select2-bootstrap.min.css" rel="stylesheet" />

<style>
    .table-head-fixed th {
        background-color: #343a40 !important;
        color: #ffffff !important;
        border-bottom: 0 !important;
        box-shadow: inset 0 -1px 0 #dee2e6;
        z-index: 10;
    }
</style>

<div class="card">
    <div class="card-header">
        <form method="get" action="/LopHocPhan/Index">
            <div class="row align-items-center">

                <div class="col-md-3 mb-2">
                    <input type="text" name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Mã LHP/Tên môn...">
                </div>

                <div class="col-md-3 mb-2">
                    <select name="maKhoa" class="form-control select2" style="width: 100%;">
                        <option value="">-- Tất cả khoa --</option>
                        @if (ViewBag.DanhSachKhoa != null)
                        {
                            foreach (var khoa in ViewBag.DanhSachKhoa)
                            {
                                <option value="@khoa.MaKhoa" selected="@(ViewBag.MaKhoa == khoa.MaKhoa ? "selected" : null)">
                                    @khoa.TenKhoa
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3 mb-2">
                    <select name="khoaHoc" class="form-control select2" style="width: 100%;">
                        <option value="" selected="@(string.IsNullOrWhiteSpace(selectedKhoaHoc) ? "selected" : null)">
                            -- Tất cả khóa --
                        </option>

                        @if (ViewBag.DSKhoaHoc != null)
                        {
                            foreach (var khoaHocItem in ViewBag.DSKhoaHoc)
                            {
                                string maKhoaHoc = Convert.ToString(khoaHocItem) ?? "";

                                <option value="@maKhoaHoc" selected="@(selectedKhoaHoc == maKhoaHoc ? "selected" : null)">
                                    Khóa @maKhoaHoc
                                </option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3 mb-2 d-flex">
                    <button type="submit" class="btn btn-primary flex-fill mr-1" title="Lọc">
                        <i class="fas fa-filter"></i> Lọc
                    </button>
                    <a href="/LopHocPhan/Index" class="btn btn-default flex-fill text-center" title="Xóa lọc">
                        <i class="fas fa-sync"></i> Xoá lọc
                    </a>
                </div>
            </div>

            <div class="row mt-1">
                <div class="col-md-12 text-left">
                    @if (User.IsInRole("Admin") || User.IsInRole("CanBo"))
                    {
                        <a href="/LopHocPhan/Create" class="btn btn-success">
                            <i class="fas fa-plus mr-1"></i> Mở lớp mới
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show m-3 shadow-sm" role="alert">
            <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show m-3 shadow-sm" role="alert">
            <i class="fas fa-exclamation-triangle mr-2"></i> @TempData["Error"]
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="card-body p-0 table-responsive" style="max-height: 550px; overflow-y: auto;">
        <table class="table table-bordered table-striped table-hover text-nowrap table-head-fixed mb-0">
            <thead class="thead-dark">
                <tr>
                    <th style="width:120px">Mã LHP</th>
                    <th>Môn học</th>
                    <th>Khoa quản lý</th>
                    <th>Giảng viên</th>
                    <th style="width:200px">Thời khóa biểu</th>
                    <th style="width:100px" class="text-center">Sĩ số Max</th>
                    <th style="width:100px" class="text-center">Thao tác</th>
                </tr>
            </thead>

            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            <i class="fas fa-search fa-3x mb-3 d-block text-secondary"></i>
                            Chưa có dữ liệu lớp học phần.
                        </td>
                    </tr>
                }

                @foreach (var lhp in Model)
                {
                    <tr>
                        <td class="font-weight-bold text-primary">@lhp.MaLhp</td>
                        <td class="font-weight-bold">@lhp.MaMonNavigation?.TenMon</td>
                        <td>
                            <span class="badge badge-secondary" style="font-size: 13px; padding: 5px 10px;">
                                <i class="fas fa-building mr-1"></i> @lhp.MaMonNavigation?.MaKhoaNavigation?.TenKhoa
                            </span>
                        </td>
                        <td>@lhp.MaGvNavigation?.HoTen</td>

                        <td>
                            <strong class="text-primary">
                                @(string.IsNullOrEmpty(lhp.ThoiKhoaBieu) ? "Chưa phân bổ lịch" : lhp.ThoiKhoaBieu)
                            </strong><br />
                            <span class="badge badge-info mt-1">
                                <i class="fas fa-map-marker-alt"></i> P. @lhp.PhongHoc
                            </span>
                        </td>

                        <td class="text-center text-danger font-weight-bold">@lhp.SiSoToiDa</td>

                        <td class="text-center">
                            @if (User.IsInRole("Admin") || User.IsInRole("CanBo"))
                            {
                                <a href="/LopHocPhan/Edit/@lhp.MaLhp?tuKhoa=@ViewBag.TuKhoa&maKhoa=@ViewBag.MaKhoa&khoaHoc=@selectedKhoaHoc" class="btn btn-warning btn-sm" title="Sửa">
                                    <i class="fas fa-edit"></i>
                                </a>

                                @if (User.IsInRole("Admin"))
                                {
                                    <form method="post" action="/LopHocPhan/Delete/@lhp.MaLhp" style="display:inline-block" onsubmit="return confirm('Xóa lớp học phần này?')">
                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="tuKhoa" value="@ViewBag.TuKhoa" />
                                        <input type="hidden" name="maKhoa" value="@ViewBag.MaKhoa" />
                                        <input type="hidden" name="khoaHoc" value="@selectedKhoaHoc" />

                                        <button type="submit" class="btn btn-danger btn-sm" title="Xóa">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="card-footer clearfix">
        <div class="float-left pt-1">
            <small class="text-muted">Tổng: <strong>@ViewBag.TongSo</strong> lớp</small>
        </div>

        @if (ViewBag.TongTrang > 1)
        {
            <ul class="pagination pagination-sm float-right mb-0">
                @for (int i = 1; i <= ViewBag.TongTrang; i++)
                {
                    <li class="page-item @(i == ViewBag.Trang ? "active" : "")">
                        <a class="page-link" href="/LopHocPhan/Index?trang=@i&tuKhoa=@ViewBag.TuKhoa&maKhoa=@ViewBag.MaKhoa&khoaHoc=@selectedKhoaHoc">
                            @i
                        </a>
                    </li>
                }
            </ul>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {
        $('.select2').select2({
        theme: "bootstrap",
        width: '100%'
        });
        });
    </script>
}