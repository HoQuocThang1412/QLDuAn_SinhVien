@model List<QuanLySinhVien.Models.DangKyHoc>
@{
    ViewData["Title"] = "Thời khóa biểu cá nhân";
    // Mảng màu Pastel cực nịnh mắt để phân biệt các môn
    var colors = new[] { "#e3f2fd", "#f3e5f5", "#e8f5e9", "#fff3e0", "#e0f7fa", "#fce4ec", "#fff8e1", "#f0f4c3", "#ffccbc" };
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/select2-bootstrap-theme/0.1.0-beta.10/select2-bootstrap.min.css" rel="stylesheet" />

<style>
    /* THUẬT TOÁN CSS GRID: Bàn cờ ma trận siêu cấp */
    .tkb-container {
        display: grid;
        /* 1 cột Tiết (80px) + 7 cột Thứ (chia đều không gian) */
        grid-template-columns: 80px repeat(7, minmax(120px, 1fr));
        /* 1 hàng Header (50px) + 10 hàng Tiết (mỗi tiết 60px) */
        grid-template-rows: 50px repeat(10, 60px);
        gap: 1px;
        background-color: #dee2e6;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        overflow-x: auto;
    }

    .tkb-header {
        background-color: #6f86d6;
        color: white;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
        text-transform: uppercase;
        font-size: 0.9rem;
    }

    .tkb-tiet {
        background-color: #f8f9fa;
        color: #495057;
        font-weight: bold;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .tkb-cell-empty {
        background-color: #ffffff;
    }

    /* Khối môn học sẽ TRÀN HẾT Ô */
    .tkb-monhoc {
        /* Tạo khoảng hở 2px so với viền ô để nhìn tách biệt */
        margin: 2px;
        border-radius: 6px;
        padding: 8px;
        font-size: 0.85rem;
        border-left: 4px solid #6f86d6;
        display: flex;
        flex-direction: column;
        justify-content: center;
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
        z-index: 10;
        overflow: hidden;
    }

        .tkb-monhoc:hover {
            transform: scale(1.02);
            box-shadow: 0 6px 12px rgba(0,0,0,0.15);
            z-index: 20;
        }

    .trung-lich {
        border-left-color: #dc3545 !important;
        background-color: #fff3cd !important;
        animation: blinker 2s linear infinite;
    }

    @@keyframes blinker {
        50% {
            opacity: 0.7;
        }
    }

    /* CSS dành riêng khi in lịch học */
    @@media print {
        .no-print,
        .main-header,
        .main-sidebar,
        .main-footer,
        .content-header {
            display: none !important;
        }

        .content-wrapper,
        .card,
        .card-body {
            margin: 0 !important;
            padding: 0 !important;
            background: #ffffff !important;
            box-shadow: none !important;
        }

        .card {
            border: none !important;
        }

        .card-header {
            border: none !important;
            padding: 0 0 15px 0 !important;
        }

        .tkb-container {
            overflow: visible !important;
            box-shadow: none !important;
        }

        .tkb-monhoc {
            break-inside: avoid;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }

        .tkb-header {
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
    }
</style>

<div class="custom-breadcrumb mt-3 mb-4 p-3 bg-light rounded shadow-sm no-print">
    <i class="fas fa-home text-secondary mr-1"></i> <a href="/" class="text-dark">Trang cá nhân</a>
    <span class="mx-2 text-muted">/</span>
    <strong class="text-primary">Lịch học trong tuần</strong>
</div>

<div class="card shadow">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h4 class="card-title font-weight-bold text-primary mb-0">
            <i class="fas fa-calendar-alt mr-2"></i> THỜI KHÓA BIỂU
        </h4>

        <div class="d-flex align-items-center no-print">
            @if (Model.Any())
            {
                <button type="button" id="btnInLichHoc" class="btn btn-primary mr-3" onclick="printThoiKhoaBieu()">
                    <i class="fas fa-print mr-1"></i> In lịch học
                </button>
            }

            <form method="get" action="/SinhVien/ThoiKhoaBieu" class="form-inline">
                <label class="mr-2 font-weight-bold text-dark">Học kỳ:</label>
                <select name="maHocKy" class="form-control select2" style="width: 250px;" onchange="this.form.submit()">
                    <option value="">-- Tất cả học kỳ --</option>
                    @if (ViewBag.DanhSachHK != null)
                    {
                        foreach (var hk in ViewBag.DanhSachHK)
                        {
                            <option value="@hk.MaHocKy" selected="@(ViewBag.MaHocKy == hk.MaHocKy ? "selected" : null)">
                                @hk.TenHocKy
                            </option>
                        }
                    }
                </select>
            </form>
        </div>
    </div>

    <div class="card-body p-4 bg-light">
        @if (!Model.Any())
        {
            <div class="text-center py-5 bg-white rounded shadow-sm">
                <i class="fas fa-calendar-times fa-4x text-muted mb-3"></i>
                <h5 class="text-secondary">Bạn chưa đăng ký môn học nào trong học kỳ này!</h5>
                <a href="/DangKyHoc/Index" class="btn btn-primary mt-3">
                    <i class="fas fa-plus-circle mr-1"></i> Đi đến trang Đăng ký
                </a>
            </div>
        }
        else
        {
            <div class="tkb-container shadow-sm">
                <div class="tkb-header" style="grid-column: 1; grid-row: 1;">Tiết</div>
                <div class="tkb-header" style="grid-column: 2; grid-row: 1;">Thứ 2</div>
                <div class="tkb-header" style="grid-column: 3; grid-row: 1;">Thứ 3</div>
                <div class="tkb-header" style="grid-column: 4; grid-row: 1;">Thứ 4</div>
                <div class="tkb-header" style="grid-column: 5; grid-row: 1;">Thứ 5</div>
                <div class="tkb-header" style="grid-column: 6; grid-row: 1;">Thứ 6</div>
                <div class="tkb-header" style="grid-column: 7; grid-row: 1;">Thứ 7</div>
                <div class="tkb-header" style="grid-column: 8; grid-row: 1;">Chủ Nhật</div>

                @for (int i = 1; i <= 10; i++)
                {
                    <div class="tkb-tiet" style="grid-column: 1; grid-row: @(i + 1);">Tiết @i</div>
                    for (int j = 2; j <= 8; j++)
                    {
                        <div class="tkb-cell-empty" style="grid-column: @j; grid-row: @(i + 1);"></div>
                    }
                }

                @{
                    int colorIndex = 0;
                    var listChiTiet = ViewBag.ListChiTiet as List<QuanLySinhVien.Models.ChiTietLichHoc> ?? new List<QuanLySinhVien.Models.ChiTietLichHoc>();

                    // Hứng danh sách từng buổi bị lỗi từ Controller
                    var listBuoiTrung = ViewBag.ListBuoiTrung as List<string> ?? new List<string>();
                }

                @foreach (var item in Model)
                {
                    var lhp = item.MaLhpNavigation;
                    if (lhp == null) continue;

                    var cacBuoiHoc = listChiTiet.Where(c => c.MaLhp == lhp.MaLhp).ToList();

                    if (!cacBuoiHoc.Any() && lhp.Thu >= 2 && lhp.TietBatDau >= 1)
                    {
                        cacBuoiHoc.Add(new QuanLySinhVien.Models.ChiTietLichHoc
                        {
                            Thu = lhp.Thu,
                            TietBatDau = lhp.TietBatDau,
                            SoTiet = lhp.SoTiet
                        });
                    }

                    string bgColor = colors[colorIndex % colors.Length];
                    colorIndex++;

                    foreach (var buoi in cacBuoiHoc)
                    {
                        if (buoi.Thu < 2 || buoi.TietBatDau < 1) continue;

                        int gridColumn = (buoi.Thu <= 8) ? buoi.Thu : 8;
                        int gridRowStart = buoi.TietBatDau + 1;
                        int rowSpan = buoi.SoTiet;
                        string phong = lhp.PhongHoc ?? "Chưa xếp";

                        // Kiểm tra chính xác tọa độ ô này có nằm trong danh sách lỗi không
                        string keyCheck = $"{lhp.MaLhp}_{buoi.Thu}_{buoi.TietBatDau}";
                        bool isTrung = listBuoiTrung.Contains(keyCheck);
                        string conflictClass = isTrung ? "trung-lich" : "";

                        <div class="tkb-monhoc @conflictClass shadow-sm"
                             style="grid-column: @gridColumn; grid-row: @gridRowStart / span @rowSpan; background-color: @bgColor;"
                             title="Mã LHP: @lhp.MaLhp"
                             onclick="alert('Môn học: @item.MaMonNavigation?.TenMon\nMã LHP: @lhp.MaLhp\nPhòng học: @phong\nGiảng viên: @(lhp.MaGvNavigation?.HoTen ?? "Chưa xếp")')">

                            <strong class="text-dark d-block text-truncate" style="font-size: 0.95rem;">
                                @item.MaMonNavigation?.TenMon
                            </strong>

                            <span class="text-muted mt-2 d-block">
                                <i class="fas fa-map-marker-alt text-danger"></i> P: @phong
                            </span>

                            <span class="text-info d-block text-truncate">
                                <i class="fas fa-user-tie"></i> GV: @(lhp.MaGvNavigation?.HoTen ?? "Chưa có")
                            </span>

                            @if (isTrung)
                            {
                                <span class="text-danger font-weight-bold mt-2 d-block" style="font-size: 0.8rem;">
                                    <i class="fas fa-exclamation-triangle"></i> TRÙNG LỊCH
                                </span>
                            }
                        </div>
                    }
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        function printThoiKhoaBieu() {
        window.print();
        }

        $(document).ready(function () {
        $('.select2').select2({ theme: "bootstrap" });
        });
    </script>
}