@model QuanLySinhVien.Models.SinhVien
@{
    ViewData["Title"] = "Sửa thông tin sinh viên";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-user-edit mr-2"></i> Sửa thông tin sinh viên
        </h3>
    </div>

    <form method="post" action="/SinhVien/Edit">
        @Html.AntiForgeryToken()

        @* MSSV ẩn — không cho sửa nhưng vẫn cần submit *@
        <input type="hidden" name="Mssv" value="@Model.Mssv">

        <div class="card-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle mr-1"></i>
                    <strong>Vui lòng kiểm tra lại thông tin:</strong>
                    <ul class="mb-0 mt-1">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="row">
                <!-- Cột trái -->
                <div class="col-md-6">

                    <div class="form-group">
                        <label>MSSV</label>
                        <input type="text"
                               value="@Model.Mssv"
                               class="form-control"
                               readonly
                               disabled
                               style="background:#e9ecef; cursor:not-allowed;">
                        <small class="text-muted">MSSV không thể thay đổi.</small>
                    </div>

                    <div class="form-group">
                        <label>Họ và tên <span class="text-danger">*</span></label>
                        <input type="text"
                               name="HoTen"
                               value="@Model.HoTen"
                               class="form-control"
                               placeholder="VD: Nguyễn Văn An"
                               maxlength="100"
                               pattern="^[A-Za-zÀ-ỹà-ỹ\s'.-]{2,100}$"
                               title="Họ tên chỉ được chứa chữ cái, khoảng trắng, dấu chấm, dấu gạch nối hoặc dấu nháy."
                               required>
                        <small class="text-muted">Nhập họ tên thật, ít nhất 2 từ. Ví dụ: Nguyễn Văn An.</small>
                    </div>

                    <div class="form-group">
                        <label>Ngày sinh <span class="text-danger">*</span></label>
                        <input type="date"
                               name="NgaySinh"
                               value="@Model.NgaySinh.ToString("yyyy-MM-dd")"
                               class="form-control"
                               required>
                        <small class="text-muted">Sinh viên phải đủ 18 tuổi.</small>
                    </div>

                    <div class="form-group">
                        <label>Giới tính</label>
                        <select name="GioiTinh" class="form-control">
                            <option value="">-- Chọn giới tính --</option>
                            @foreach (var gt in new[] { "Nam", "Nữ", "Khác" })
                            {
                                if (Model.GioiTinh == gt)
                                {
                                    <option value="@gt" selected="selected">@gt</option>
                                }
                                else
                                {
                                    <option value="@gt">@gt</option>
                                }
                            }
                        </select>
                    </div>

                </div>

                <!-- Cột phải -->
                <div class="col-md-6">

                    <div class="form-group">
                        <label>Lớp học <span class="text-danger">*</span></label>
                        <select name="MaLop" class="form-control" required>
                            <option value="">-- Chọn lớp --</option>
                            @foreach (var lop in ViewBag.DanhSachLop)
                            {
                                if (Model.MaLop == lop.MaLop)
                                {
                                    <option value="@lop.MaLop" selected="selected">@lop.TenLop</option>
                                }
                                else
                                {
                                    <option value="@lop.MaLop">@lop.TenLop</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Trạng thái <span class="text-danger">*</span></label>
                        <select name="TrangThai" class="form-control" required>
                            @foreach (var tt in new[] { "Đang học", "Bảo lưu", "Đã tốt nghiệp", "Thôi học" })
                            {
                                if (Model.TrangThai == tt)
                                {
                                    <option value="@tt" selected="selected">@tt</option>
                                }
                                else
                                {
                                    <option value="@tt">@tt</option>
                                }
                            }
                        </select>
                    </div>

                    <input type="text"
                           name="SoDienThoai"
                           value="@Model.SoDienThoai"
                           class="form-control"
                           placeholder="0xxxxxxxxx"
                           maxlength="10"
                           pattern="^0[0-9]{9}$"
                           title="Số điện thoại phải gồm đúng 10 chữ số và bắt đầu bằng 0.">
                    <small class="text-muted">Đúng 10 chữ số, bắt đầu bằng 0. Ví dụ: 0901234567.</small>

                    <div class="form-group">
                        <label>Email</label>
                        <input type="email"
                               name="Email"
                               value="@Model.Email"
                               class="form-control"
                               placeholder="example@email.com">
                    </div>

                    <div class="form-group">
                        <label>Địa chỉ</label>
                        <input type="text"
                               name="DiaChi"
                               value="@Model.DiaChi"
                               class="form-control"
                               maxlength="255"
                               placeholder="Số nhà, đường, phường, tỉnh/thành phố">
                    </div>

                </div>
            </div>

        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-warning">
                <i class="fas fa-save mr-1"></i> Lưu thay đổi
            </button>

            <a href="/SinhVien/Detail/@Model.Mssv" class="btn btn-info ml-2">
                <i class="fas fa-eye mr-1"></i> Xem hồ sơ
            </a>

            <a href="/SinhVien/Index" class="btn btn-default ml-2">
                <i class="fas fa-arrow-left mr-1"></i> Quay lại
            </a>
        </div>
    </form>
</div>