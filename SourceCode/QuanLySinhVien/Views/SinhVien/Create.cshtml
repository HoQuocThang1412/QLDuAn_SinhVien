@model QuanLySinhVien.Models.SinhVien
@{
    ViewData["Title"] = "Thêm sinh viên mới";
    string selectedKhoaHoc = ViewBag.KhoaHoc ?? "";
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-user-plus mr-2"></i> Thêm sinh viên mới
        </h3>
    </div>

    <form method="post" action="/SinhVien/Create">
        @Html.AntiForgeryToken()
        <div class="card-body">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle mr-1"></i>
                    <strong>Vui lòng kiểm tra lại thông tin:</strong>
                    <ul class="mb-0 mt-1">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                            <li>@error.ErrorMessage</li>
                        }
                    </ul>
                </div>
            }

            <div class="row">
                <!-- Cột trái -->
                <div class="col-md-6">
                    <div class="form-group">
                        <label>MSSV <span class="text-danger">*</span></label>
                        <input type="text"
                               name="Mssv"
                               value="@Model?.Mssv"
                               class="form-control"
                               placeholder="VD: SV2200001"
                               maxlength="10"
                               required>
                        <small class="text-muted">Tối đa 10 ký tự, không thể thay đổi sau khi lưu.</small>
                    </div>

                    <div class="form-group">
                        <label>Họ và tên <span class="text-danger">*</span></label>
                        <input type="text"
                               name="HoTen"
                               value="@Model?.HoTen"
                               class="form-control"
                               placeholder="VD: Nguyễn Văn An"
                               maxlength="100"
                               pattern="^[A-Za-zÀ-ỹà-ỹ\s'.-]{2,100}$"
                               title="Họ tên chỉ được chứa chữ cái, khoảng trắng, dấu chấm, dấu gạch nối hoặc dấu nháy."
                               required>
                        <small class="text-muted">Nhập họ tên thật, ít nhất 2 từ. Ví dụ: Nguyễn Văn An.</small>
                    </div>

                    <div class="form-group">
                        <label>Ngày sinh <span class="text-danger">*</span></label>
                        <input type="date"
                               name="NgaySinh"
                               value="@Model?.NgaySinh.ToString("yyyy-MM-dd")"
                               class="form-control"
                               required>
                        <small class="text-muted">Sinh viên phải đủ 18 tuổi.</small>
                    </div>

                    <div class="form-group">
                        <label>Giới tính</label>
                        <select name="GioiTinh" class="form-control">
                            <option value="">-- Chọn giới tính --</option>
                            <option value="Nam" selected="@(Model?.GioiTinh == "Nam" ? "selected" : null)">Nam</option>
                            <option value="Nữ" selected="@(Model?.GioiTinh == "Nữ" ? "selected" : null)">Nữ</option>
                            <option value="Khác" selected="@(Model?.GioiTinh == "Khác" ? "selected" : null)">Khác</option>
                        </select>
                    </div>
                </div>

                <!-- Cột phải -->
                <div class="col-md-6">

                    <!-- Chọn Khoa trước để lọc lớp -->
                    <div class="form-group">
                        <label>Khoa <span class="text-danger">*</span></label>
                        <select id="selKhoa"
                                class="form-control"
                                onchange="khoaChangedSV(this)">
                            <option value="">-- Chọn khoa --</option>
                            @foreach (var khoa in ViewBag.DanhSachKhoa)
                            {
                                <option value="@khoa.MaKhoa">@khoa.TenKhoa</option>
                            }
                        </select>
                    </div>

                    <!-- Chọn Khóa học -->
                    <div class="form-group">
                        <label>Khóa học <span class="text-danger">*</span></label>
                        <select name="khoaHoc"
                                id="selKhoaHoc"
                                class="form-control"
                                onchange="khoaHocChangedSV(this)"
                                required>
                            <option value="">-- Chọn khóa học --</option>
                            @if (ViewBag.DSKhoaHoc != null)
                            {
                                foreach (var kh in ViewBag.DSKhoaHoc)
                                {
                                    <option value="@kh" selected="@(selectedKhoaHoc == kh ? "selected" : null)">
                                        Khóa @kh
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <!-- Chuyên ngành SP -->
                    <div class="form-group" id="divChuyenNganh" style="display:none;">
                        <label>Chuyên ngành <span class="text-danger">*</span></label>
                        <select id="selChuyenNganh"
                                class="form-control"
                                onchange="chuyenNganhChangedSV(this)">
                            <option value="">-- Chọn chuyên ngành --</option>
                        </select>
                    </div>

                    <!-- Lớp học lọc theo khoa -->
                    <div class="form-group">
                        <label>Lớp học <span class="text-danger">*</span></label>
                        <select name="MaLop"
                                id="selLop"
                                class="form-control"
                                required>
                            <option value="">-- Chọn khoa trước --</option>
                            @foreach (var lop in ViewBag.DanhSachLop)
                            {
                                <option value="@lop.MaLop"
                                        data-khoa="@lop.MaKhoa"
                                        data-khoahoc="@lop.KhoaHoc"
                                        selected="@(Model?.MaLop == lop.MaLop ? "selected" : null)">
                                    @lop.TenLop
                                </option>
                            }
                        </select>
                    </div>

                    <input type="text"
                           name="SoDienThoai"
                           value="@Model?.SoDienThoai"
                           class="form-control"
                           placeholder="0xxxxxxxxx"
                           maxlength="10"
                           pattern="^0[0-9]{9}$"
                           title="Số điện thoại phải gồm đúng 10 chữ số và bắt đầu bằng 0.">
                    <small class="text-muted">Đúng 10 chữ số, bắt đầu bằng 0. Ví dụ: 0901234567.</small>

                    <div class="form-group">
                        <label>Email</label>
                        <input type="email"
                               name="Email"
                               value="@Model?.Email"
                               class="form-control"
                               placeholder="example@email.com">
                    </div>

                    <div class="form-group">
                        <label>Địa chỉ</label>
                        <input type="text"
                               name="DiaChi"
                               value="@Model?.DiaChi"
                               class="form-control"
                               maxlength="255"
                               placeholder="Số nhà, đường, phường, tỉnh/thành phố">
                    </div>
                </div>
            </div>

            <div class="alert alert-info py-2">
                <i class="fas fa-info-circle mr-1"></i>
                Các trường có dấu <span class="text-danger">*</span> là bắt buộc.
                Trạng thái mặc định sẽ là <strong>Đang học</strong>.
            </div>
        </div>

        <div class="card-footer">
            <button type="submit" class="btn btn-success">
                <i class="fas fa-save mr-1"></i> Lưu sinh viên
            </button>
            <a href="/SinhVien/Index" class="btn btn-default ml-2">
                <i class="fas fa-arrow-left mr-1"></i> Quay lại
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        var originalLopOptions = [];

        document.addEventListener('DOMContentLoaded', function () {
            var selLop = document.getElementById('selLop');

            selLop.querySelectorAll('option').forEach(function (opt) {
                if (opt.value) {
                    originalLopOptions.push(opt.cloneNode(true));
                }
            });
        });

        function chuanHoaKhoaHoc(value) {
            if (!value) return '';

            value = value.trim();

            if (value.toLowerCase().startsWith('khóa ')) {
                value = value.substring(5).trim();
            }

            if (!value.toUpperCase().startsWith('K')) {
                value = 'K' + value;
            }

            return value.toUpperCase();
        }

        function khoaChangedSV(selectEl) {
            var maKhoa = selectEl.value;
            var divCN = document.getElementById('divChuyenNganh');
            var selCN = document.getElementById('selChuyenNganh');

            if (maKhoa === 'SP') {
                divCN.style.display = 'block';
                selCN.innerHTML = '<option value="">-- Chọn chuyên ngành --</option>';

                if (typeof chuyenNganhSP !== 'undefined') {
                    chuyenNganhSP.forEach(function (cn) {
                        selCN.innerHTML += '<option value="' + cn.ma + '">' + cn.ten + '</option>';
                    });
                }
            } else {
                divCN.style.display = 'none';
                selCN.value = '';
            }

            locLop(maKhoa);
        }

        function khoaHocChangedSV(selectEl) {
            var maKhoa = document.getElementById('selKhoa').value;
            locLop(maKhoa);
        }

        function chuyenNganhChangedSV(selectEl) {
            var maCN = selectEl.value;
            locLop(maCN || 'SP');
        }

        function locLop(maKhoa) {
            var selLop = document.getElementById('selLop');
            var khoaHoc = chuanHoaKhoaHoc(document.getElementById('selKhoaHoc').value);

            selLop.innerHTML = '<option value="">-- Chọn lớp --</option>';

            originalLopOptions.forEach(function (opt) {
                var khoaLop = opt.getAttribute('data-khoa');
                var khoaHocLop = chuanHoaKhoaHoc(opt.getAttribute('data-khoahoc'));
                var tenLop = (opt.textContent || '').toUpperCase();

                var dungKhoa = !maKhoa || khoaLop === maKhoa;
                var dungKhoaHoc = !khoaHoc || khoaHocLop === khoaHoc || tenLop.includes(khoaHoc);

                if (dungKhoa && dungKhoaHoc) {
                    selLop.appendChild(opt.cloneNode(true));
                }
            });

            if (selLop.options.length === 1) {
                selLop.innerHTML = '<option value="">-- Không có lớp --</option>';
            }
        }
    </script>
}