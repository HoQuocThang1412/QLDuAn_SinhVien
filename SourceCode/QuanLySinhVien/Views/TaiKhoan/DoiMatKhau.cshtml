@{
    ViewData["Title"] = "Đổi mật khẩu bảo mật";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-5">
        <div class="card card-outline card-primary shadow-sm">
            <div class="card-header text-center">
                <h3 class="card-title font-weight-bold w-100"><i class="fas fa-user-shield mr-1 text-warning"></i> THAY ĐỔI MẬT KHẨU</h3>
            </div>
            
            <form asp-action="DoiMatKhau" asp-controller="TaiKhoan" method="post">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div class="text-center mb-3">
                        <img src="https://cdn-icons-png.flaticon.com/512/6195/6195696.png" width="80" alt="Security" />
                        <p class="text-muted mt-2 small">Vui lòng nhập mật khẩu cũ để xác thực và đặt mật khẩu mới.</p>
                    </div>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger font-weight-bold shadow-sm">
                            <i class="fas fa-exclamation-triangle"></i> @ViewBag.Error
                        </div>
                    }

                    <div class="form-group">
                        <label class="font-weight-bold">Mật khẩu hiện tại <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <div class="input-group-prepend"><span class="input-group-text"><i class="fas fa-unlock-alt"></i></span></div>
                            <input type="password" name="matKhauCu" class="form-control" required placeholder="Nhập mật khẩu đang sử dụng..." />
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label class="font-weight-bold">Mật khẩu mới <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <div class="input-group-prepend"><span class="input-group-text"><i class="fas fa-key text-success"></i></span></div>
                            <input type="password" name="matKhauMoi" class="form-control" required minlength="6" placeholder="Mật khẩu mới (tối thiểu 6 ký tự)..." />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="font-weight-bold">Xác nhận mật khẩu mới <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <div class="input-group-prepend"><span class="input-group-text"><i class="fas fa-check-double text-primary"></i></span></div>
                            <input type="password" name="xacNhanMatKhau" class="form-control" required minlength="6" placeholder="Nhập lại mật khẩu mới..." />
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-white text-center">
                    <a href="javascript:history.back()" class="btn btn-default shadow-sm mr-2"><i class="fas fa-times"></i> Hủy bỏ</a>
                    <button type="submit" class="btn btn-primary font-weight-bold shadow-sm"><i class="fas fa-save mr-1"></i> Xác nhận đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>