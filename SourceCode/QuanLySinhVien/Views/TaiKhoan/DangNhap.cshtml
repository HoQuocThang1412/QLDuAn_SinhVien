@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng nhập — Quản lý Sinh viên QNU</title>
    <link rel="stylesheet" href="~/adminlte/plugins/fontawesome-free/css/all.min.css">
    <link rel="stylesheet" href="~/adminlte/dist/css/adminlte.min.css">
    <style>
        body { background: #f4f6f9; margin: 0; font-family: 'Segoe UI', sans-serif; }
        .login-page {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .login-wrapper {
            display: flex;
            width: 900px;
            min-height: 520px;
            border-radius: 12px;
            overflow: hidden;
            box-shadow: 0 4px 24px rgba(0,0,0,0.15);
        }
        .login-left {
            flex: 1;
            background: url('/images/bg_truong.jpg') center/cover no-repeat;
        }
        .login-right {
            width: 380px;
            background: #f0f2f5;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 36px;
        }
        .login-school  { font-size: 13px; font-weight: 700; color: #1a3a6c; text-transform: uppercase; margin-bottom: 4px; text-align: center; }
        .login-title   { font-size: 20px; font-weight: 800; color: #c8102e; text-transform: uppercase; margin-bottom: 20px; text-align: center; }
        .form-card     { width: 100%; background: #fff; border-radius: 10px; padding: 24px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); }
        .form-card h5  { color: #c8102e; font-weight: 700; font-size: 20px; margin-bottom: 2px; }
        .form-card p   { color: #6c757d; font-size: 12px; margin-bottom: 16px; }
        .input-group-text { background: #eaf2fb !important; border-color: #b8cce4 !important; }
        .form-control  { background: #eaf2fb !important; border-color: #b8cce4 !important; }
        .btn-login     { background: #1a3a6c; color: #fff; width: 100%; padding: 10px; font-weight: 600; border: none; border-radius: 6px; font-size: 15px; }
        .btn-login:hover { background: #0d2248; }
        .forgot-link   { display: block; text-align: center; margin-top: 12px; font-size: 13px; color: #6c757d; }
    </style>
</head>
<body>
    <div class="login-page">
        <div class="login-wrapper">

            <!-- Bên trái: ảnh trường -->
            <div class="login-left"></div>

            <!-- Bên phải: form -->
            <div class="login-right">
                <div class="login-school">Trường Đại học Quy Nhơn</div>
                <div class="login-title">Quản lý Sinh viên QNU</div>

                <div class="form-card">
                    <h5>ĐĂNG NHẬP</h5>
                    <p>Phần mềm Quản lý Sinh viên — Quy Nhơn ADV</p>

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger py-2 mb-3">
                            <i class="fas fa-exclamation-circle mr-1"></i> @ViewBag.Error
                        </div>
                    }

                    <form method="post" action="/TaiKhoan/DangNhap">
                        <div class="input-group mb-3">
                            <input type="text" name="tenDangNhap"
                                   class="form-control"
                                   placeholder="Tên đăng nhập"
                                   required autofocus>
                            <div class="input-group-append">
                                <div class="input-group-text">
                                    <i class="fas fa-user"></i>
                                </div>
                            </div>
                        </div>

                        <div class="input-group mb-3">
                            <input type="password" name="matKhau"
                                   class="form-control"
                                   placeholder="Mật khẩu"
                                   required>
                            <div class="input-group-append">
                                <div class="input-group-text">
                                    <i class="fas fa-lock"></i>
                                </div>
                            </div>
                        </div>

                        <button type="submit" class="btn-login">
                            <i class="fas fa-sign-in-alt mr-1"></i> Đăng nhập
                        </button>
                    </form>

                    <a href="/TaiKhoan/QuenMatKhau" class="forgot-link">
                        Quên mật khẩu?
                    </a>
                </div>
            </div>

        </div>
    </div>
    <script src="~/adminlte/plugins/jquery/jquery.min.js"></script>
    <script src="~/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>
</body>
</html>