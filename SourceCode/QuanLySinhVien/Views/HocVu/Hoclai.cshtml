@model QuanLySinhVien.Models.ViewModels.HocLaiCuaToiViewModel

@{
    ViewData["Title"] = "Môn cần học lại";
}

<style>
    .my-retake-page .hero-card {
        border: 0;
        border-radius: 18px;
        background: linear-gradient(135deg, #2563eb, #38bdf8);
        color: #fff;
        box-shadow: 0 8px 24px rgba(37, 99, 235, .22);
        overflow: hidden;
    }

    .my-retake-page .hero-title {
        font-weight: 800;
        font-size: 1.5rem;
    }

    .my-retake-page .hero-subtitle {
        opacity: .92;
        font-size: .95rem;
    }

    .my-retake-page .filter-card,
    .my-retake-page .subject-card {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .08);
    }

    .my-retake-page .subject-card {
        overflow: hidden;
    }

    .my-retake-page .subject-header {
        background: #fff;
        border-bottom: 1px solid #edf2f7;
        padding: 18px 20px;
    }

    .my-retake-page .subject-title {
        font-weight: 800;
        color: #111827;
        font-size: 1.05rem;
    }

    .my-retake-page .info-chip {
        display: inline-flex;
        align-items: center;
        padding: 7px 12px;
        border-radius: 999px;
        background: #f3f4f6;
        color: #374151;
        font-size: .82rem;
        font-weight: 700;
        margin-right: 6px;
        margin-bottom: 6px;
    }

    .my-retake-page .class-box {
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        padding: 14px;
        background: #f8fafc;
        height: 100%;
    }

    .my-retake-page .class-code {
        font-weight: 800;
        color: #2563eb;
        font-size: 1rem;
    }

    .my-retake-page .btn-register {
        border-radius: 10px;
        font-weight: 700;
    }

    .my-retake-page .empty-state {
        text-align: center;
        color: #64748b;
        padding: 42px 20px;
    }

        .my-retake-page .empty-state i {
            font-size: 46px;
            color: #cbd5e1;
            margin-bottom: 12px;
        }
</style>

<div class="my-retake-page">

    <div class="card hero-card mb-4">
        <div class="card-body p-4">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <div class="hero-title">
                        <i class="fas fa-redo-alt mr-2"></i>
                        Môn cần học lại của tôi
                    </div>
                    <div class="hero-subtitle mt-1">
                        Xem các môn chưa đạt và lớp học phần hiện đang/sắp mở để đăng ký học lại.
                    </div>
                </div>

                <div class="text-right mt-3 mt-md-0">
                    <div class="font-weight-bold">
                        @Model.Mssv - @Model.HoTen
                    </div>
                    <div class="small">
                        Lớp: @Model.Lop
                        @if (!string.IsNullOrWhiteSpace(Model.KhoaHoc))
                        {
                            <span>| Khóa: @Model.KhoaHoc</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle mr-1"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle mr-1"></i>
            @TempData["Error"]
        </div>
    }

    <div class="card filter-card mb-4">
        <div class="card-body">
            <form method="get" asp-controller="HocVu" asp-action="Hoclai">
                <div class="row align-items-end">
                    <div class="col-md-5">
                        <label class="font-weight-bold text-muted">
                            Học kỳ đang mở để đăng ký
                        </label>
                        <select name="maHocKy"
                                class="form-control"
                                asp-items="Model.DanhSachHocKyDangMo"
                                onchange="this.form.submit()">
                            <option value="">-- Tất cả học kỳ đang/sắp mở --</option>
                        </select>
                    </div>

                    <div class="col-md-7 mt-3 mt-md-0">
                        <span class="info-chip">
                            <i class="fas fa-times-circle text-danger mr-1"></i>
                            @Model.TongMonRot môn chưa đạt
                        </span>

                        <span class="info-chip">
                            <i class="fas fa-chalkboard-teacher text-primary mr-1"></i>
                            @Model.TongLopCoTheDangKy lớp học phần có thể đăng ký
                        </span>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @if (Model.DanhSachMonRot.Any())
    {
        foreach (var mon in Model.DanhSachMonRot)
        {
            <div class="card subject-card mb-4">
                <div class="subject-header">
                    <div class="d-flex justify-content-between align-items-start flex-wrap">
                        <div>
                            <div class="subject-title">
                                @mon.MaMon - @mon.TenMon
                            </div>

                            <div class="mt-2">
                                <span class="info-chip">
                                    <i class="fas fa-book mr-1"></i>
                                    @mon.SoTinChi tín chỉ
                                </span>

                                <span class="info-chip">
                                    <i class="fas fa-calendar-alt mr-1"></i>
                                    Rớt ở: @mon.HocKyRot
                                </span>

                                <span class="info-chip">
                                    <i class="fas fa-chart-line mr-1"></i>
                                    Điểm: @(mon.DiemTongKet?.ToString("0.0") ?? "-")
                                </span>

                                <span class="info-chip">
                                    <i class="fas fa-medal mr-1"></i>
                                    @(string.IsNullOrWhiteSpace(mon.XepLoai) ? "Chưa xếp loại" : mon.XepLoai)
                                </span>
                            </div>
                        </div>

                        <span class="badge badge-danger mt-2">
                            Chưa đạt
                        </span>
                    </div>
                </div>

                <div class="card-body">
                    <div class="font-weight-bold text-dark mb-3">
                        <i class="fas fa-list text-primary mr-1"></i>
                        Lớp học phần hiện đang/sắp mở
                    </div>

                    @if (mon.LopHocPhanDangMo.Any())
                    {
                        <div class="row">
                            @foreach (var lhp in mon.LopHocPhanDangMo)
                            {
                                <div class="col-lg-4 col-md-6 mb-3">
                                    <div class="class-box">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div class="class-code">
                                                @lhp.MaLhp
                                            </div>

                                            @if (lhp.ConCho)
                                            {
                                                <span class="badge badge-success">
                                                    Còn @lhp.SoChoConLai chỗ
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">
                                                    Hết chỗ
                                                </span>
                                            }
                                        </div>

                                        <div class="text-muted small mt-2">
                                            <i class="fas fa-calendar-alt mr-1"></i>
                                            @lhp.TenHocKy
                                        </div>

                                        <div class="text-muted small">
                                            <i class="fas fa-user-tie mr-1"></i>
                                            GV: @lhp.TenGiangVien
                                        </div>

                                        <div class="text-muted small">
                                            <i class="fas fa-clock mr-1"></i>
                                            @lhp.LichHoc
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(lhp.PhongHoc))
                                        {
                                            <div class="text-muted small">
                                                <i class="fas fa-door-open mr-1"></i>
                                                Phòng: @lhp.PhongHoc
                                            </div>
                                        }

                                        <div class="text-muted small">
                                            <i class="fas fa-users mr-1"></i>
                                            Sĩ số: @lhp.SiSoDaDangKy/@lhp.SiSoToiDa
                                        </div>

                                        <form method="post"
                                              asp-controller="DangKyHoc"
                                              asp-action="DangKy"
                                              class="mt-3">
                                            @Html.AntiForgeryToken()

                                            <input type="hidden" name="mssv" value="@Model.Mssv" />
                                            <input type="hidden" name="maLhp" value="@lhp.MaLhp" />
                                            <input type="hidden" name="maHocKy" value="@lhp.MaHocKy" />

                                            <button type="submit"
                                                    class="btn btn-primary btn-block btn-register"
                                                    disabled="@(!lhp.ConCho)">
                                                <i class="fas fa-plus-circle mr-1"></i>
                                                Đăng ký học lại
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-light border mb-0">
                            <i class="fas fa-info-circle text-muted mr-1"></i>
                            Hiện chưa có lớp học phần đang/sắp mở cho môn này.
                        </div>
                    }
                </div>
            </div>
        }
    }
    else
    {
        <div class="card subject-card">
            <div class="empty-state">
                <i class="fas fa-check-circle d-block"></i>
                <h5 class="font-weight-bold">
                    Bạn chưa có môn rớt cần học lại
                </h5>
                <div>
                    Hiện không có môn chưa đạt trong dữ liệu kết quả học tập.
                </div>
            </div>
        </div>
    }
</div>