@model QuanLySinhVien.Models.ViewModels.HocVuIndexViewModel

@{
    ViewData["Title"] = "Cảnh báo học vụ";
    int soCanXuLy = Model.SoCanTheoDoi + Model.SoCanhBaoHocVu + Model.SoNguyCoHocVu;
}

<style>
    .hocvu-page .card-custom {
        border: 0;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(15, 23, 42, .08);
        overflow: hidden;
    }

    .hocvu-page .page-title {
        font-size: 1.45rem;
        font-weight: 800;
        color: #1f2937;
    }

    .hocvu-page .page-subtitle {
        color: #6b7280;
        font-size: .95rem;
    }

    .hocvu-page .stat-card {
        border: 0;
        border-radius: 16px;
        padding: 18px;
        color: #fff;
        min-height: 120px;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .10);
        position: relative;
        overflow: hidden;
    }

    .hocvu-page .stat-number {
        font-size: 1.85rem;
        font-weight: 800;
    }

    .hocvu-page .stat-label {
        font-size: .88rem;
        opacity: .95;
    }

    .hocvu-page .stat-icon {
        position: absolute;
        right: 16px;
        bottom: 10px;
        font-size: 42px;
        opacity: .25;
    }

    .bg-blue { background: linear-gradient(135deg, #2563eb, #38bdf8); }
    .bg-green { background: linear-gradient(135deg, #059669, #34d399); }
    .bg-cyan { background: linear-gradient(135deg, #0891b2, #22d3ee); }
    .bg-orange { background: linear-gradient(135deg, #f59e0b, #fb923c); }
    .bg-red { background: linear-gradient(135deg, #dc2626, #fb7185); }
    .bg-gray { background: linear-gradient(135deg, #475569, #94a3b8); }

    .hocvu-page .form-control {
        border-radius: 10px;
        min-height: 40px;
    }

    .hocvu-page label {
        font-size: .82rem;
        font-weight: 700;
        color: #4b5563;
    }

    .hocvu-page .table thead th {
        background: #f8fafc;
        color: #475569;
        font-size: .78rem;
        text-transform: uppercase;
        white-space: nowrap;
        vertical-align: middle;
    }

    .hocvu-page .table tbody td {
        vertical-align: middle;
        font-size: .88rem;
    }

    .hocvu-page .student-code {
        font-weight: 800;
        color: #2563eb;
    }

    .hocvu-page .student-name {
        font-weight: 700;
        color: #111827;
    }

    .hocvu-page .progress {
        height: 8px;
        border-radius: 999px;
    }

    .hocvu-page .chart-box {
        height: 280px;
    }

    .hocvu-page .empty-state {
        padding: 34px;
        text-align: center;
        color: #64748b;
    }
</style>

<div class="hocvu-page">

    <div class="d-flex justify-content-between align-items-start flex-wrap mb-3">
        <div>
            <div class="page-title">
                <i class="fas fa-user-shield text-danger mr-2"></i>
                Dashboard học vụ & cảnh báo
            </div>
            <div class="page-subtitle">
                Phân tích kết quả học tập, cảnh báo học vụ và đề xuất học lại môn rớt.
            </div>
        </div>

        <div class="mt-2 mt-md-0">
            <a class="btn btn-success font-weight-bold"
               asp-controller="HocVu"
               asp-action="XuatBaoCao"
               asp-route-maHocKy="@Model.MaHocKy"
               asp-route-maKhoa="@Model.MaKhoa"
               asp-route-khoaHoc="@Model.KhoaHoc"
               asp-route-maLop="@Model.MaLop"
               asp-route-mucCanhBao="@Model.MucCanhBao">
                <i class="fas fa-file-csv mr-1"></i>
                Xuất báo cáo
            </a>
        </div>
    </div>

    <div class="card card-custom mb-4">
        <div class="card-header bg-white">
            <div class="font-weight-bold">
                <i class="fas fa-filter text-primary mr-1"></i>
                Bộ lọc dữ liệu
            </div>
        </div>

        <form method="get" asp-controller="HocVu" asp-action="Index">
            <div class="card-body">
                <div class="row">
                    <div class="col-lg-2 col-md-4 mb-3">
                        <label>Học kỳ</label>
                        <select name="maHocKy"
                                class="form-control"
                                asp-items="Model.DanhSachHocKy"
                                onchange="this.form.submit()">
                            <option value="">Tất cả học kỳ</option>
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-4 mb-3">
                        <label>Khoa</label>
                        <select name="maKhoa"
                                class="form-control"
                                asp-items="Model.DanhSachKhoa"
                                onchange="this.form.submit()">
                            <option value="">Tất cả khoa</option>
                        </select>
                    </div>

                    <div class="col-lg-2 col-md-4 mb-3">
                        <label>Khóa</label>
                        <select name="khoaHoc"
                                class="form-control"
                                asp-items="Model.DanhSachKhoaHoc"
                                onchange="this.form.submit()">
                            <option value="">Tất cả khóa</option>
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-6 mb-3">
                        <label>Lớp</label>
                        <select name="maLop"
                                class="form-control"
                                asp-items="Model.DanhSachLop">
                            <option value="">Tất cả lớp</option>
                        </select>
                    </div>

                    <div class="col-lg-3 col-md-6 mb-3">
                        <label>Mức cảnh báo</label>
                        <select name="mucCanhBao"
                                class="form-control"
                                asp-items="Model.DanhSachMucCanhBao">
                            <option value="">Tất cả mức</option>
                        </select>
                    </div>
                </div>

                <div class="text-right">
                    <a href="/HocVu/Index" class="btn btn-light font-weight-bold mr-2">
                        <i class="fas fa-sync-alt mr-1"></i>
                        Làm mới
                    </a>
                    <button type="submit" class="btn btn-primary font-weight-bold">
                        <i class="fas fa-search mr-1"></i>
                        Xem thống kê
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div class="row mb-4">
        <div class="col-xl-2 col-md-4 col-6 mb-3">
            <div class="stat-card bg-blue">
                <div class="stat-number">@Model.TongSinhVien</div>
                <div class="stat-label">Sinh viên phân tích</div>
                <i class="fas fa-users stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6 mb-3">
            <div class="stat-card bg-green">
                <div class="stat-number">@Model.SoBinhThuong</div>
                <div class="stat-label">Bình thường</div>
                <i class="fas fa-check-circle stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6 mb-3">
            <div class="stat-card bg-cyan">
                <div class="stat-number">@Model.SoCanTheoDoi</div>
                <div class="stat-label">Cần theo dõi</div>
                <i class="fas fa-eye stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6 mb-3">
            <div class="stat-card bg-orange">
                <div class="stat-number">@Model.SoCanhBaoHocVu</div>
                <div class="stat-label">Cảnh báo học vụ</div>
                <i class="fas fa-exclamation-triangle stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6 mb-3">
            <div class="stat-card bg-red">
                <div class="stat-number">@Model.SoNguyCoHocVu</div>
                <div class="stat-label">Nguy cơ học vụ</div>
                <i class="fas fa-radiation-alt stat-icon"></i>
            </div>
        </div>

        <div class="col-xl-2 col-md-4 col-6 mb-3">
            <div class="stat-card bg-gray">
                <div class="stat-number">@Model.TiLeSinhVienCanhBao%</div>
                <div class="stat-label">Tỉ lệ cần xử lý</div>
                <i class="fas fa-percent stat-icon"></i>
            </div>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-5 mb-3">
            <div class="card card-custom h-100">
                <div class="card-header bg-white">
                    <div class="font-weight-bold">
                        <i class="fas fa-chart-pie text-primary mr-1"></i>
                        Tỉ lệ mức cảnh báo
                    </div>
                </div>
                <div class="card-body chart-box">
                    <canvas id="chartCanhBaoPie"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-7 mb-3">
            <div class="card card-custom h-100">
                <div class="card-header bg-white">
                    <div class="font-weight-bold">
                        <i class="fas fa-chart-bar text-success mr-1"></i>
                        Số lượng sinh viên theo mức cảnh báo
                    </div>
                </div>
                <div class="card-body chart-box">
                    <canvas id="chartCanhBaoBar"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-custom mb-4">
        <div class="card-header bg-white">
            <div class="d-flex justify-content-between align-items-center flex-wrap">
                <div>
                    <div class="font-weight-bold">
                        <i class="fas fa-list text-danger mr-1"></i>
                        Danh sách cảnh báo học vụ
                    </div>
                    <div class="text-muted small">
                        Tổng @Model.DanhSachCanhBao.Count sinh viên theo bộ lọc hiện tại.
                    </div>
                </div>

                <div>
                    <span class="badge badge-info p-2">Cần xử lý: @soCanXuLy</span>
                    <span class="badge badge-secondary p-2">Chưa đủ dữ liệu: @Model.SoChuaDuDuLieu</span>
                </div>
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Sinh viên</th>
                            <th>Lớp</th>
                            <th>Khóa</th>
                            <th>Khoa</th>
                            <th class="text-center">ĐK</th>
                            <th class="text-center">Qua</th>
                            <th class="text-center">Rớt</th>
                            <th class="text-center">Chưa điểm</th>
                            <th class="text-center">ĐTB</th>
                            <th style="min-width:140px;">Tỉ lệ qua</th>
                            <th>Mức cảnh báo</th>
                            <th style="min-width:220px;">Lý do</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var sv in Model.DanhSachCanhBao)
                        {
                            var tiLe = Math.Min(Math.Max(sv.TiLeQuaMon, 0), 100);
                            var progressClass = sv.TiLeQuaMon >= 80 ? "bg-success"
                                : sv.TiLeQuaMon >= 50 ? "bg-warning"
                                : "bg-danger";

                            <tr>
                                <td>
                                    <div class="student-code">@sv.Mssv</div>
                                    <div class="student-name">@sv.HoTen</div>
                                </td>

                                <td>
                                    <span class="font-weight-bold">@sv.TenLop</span>
                                    <div class="text-muted small">@sv.MaLop</div>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(sv.KhoaHoc) ? "Chưa có" : sv.KhoaHoc)
                                </td>

                                <td>@sv.TenKhoa</td>

                                <td class="text-center font-weight-bold">@sv.SoMonDangKy</td>

                                <td class="text-center">
                                    <span class="badge badge-success">@sv.SoMonQua</span>
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-danger">@sv.SoMonRot</span>
                                </td>

                                <td class="text-center">
                                    <span class="badge badge-secondary">@sv.SoMonChuaCoDiem</span>
                                </td>

                                <td class="text-center font-weight-bold">
                                    @(sv.DiemTrungBinh?.ToString("0.00") ?? "-")
                                </td>

                                <td>
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span>@sv.TiLeQuaMon%</span>
                                        <span>@sv.SoMonQua/@sv.SoMonDaCoDiem</span>
                                    </div>
                                    <div class="progress">
                                        <div class="progress-bar @progressClass"
                                             style="width:@tiLe%">
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="badge badge-@sv.CssClass">
                                        @sv.MucCanhBao
                                    </span>
                                </td>

                                <td class="text-muted small">
                                    @sv.LyDoCanhBao
                                </td>

                                <td>
                                    <a asp-controller="HocVu"
                                       asp-action="ChiTietSinhVien"
                                       asp-route-mssv="@sv.Mssv"
                                       asp-route-maHocKy="@Model.MaHocKy"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye mr-1"></i>
                                        Chi tiết
                                    </a>
                                </td>
                            </tr>
                        }

                        @if (!Model.DanhSachCanhBao.Any())
                        {
                            <tr>
                                <td colspan="13">
                                    <div class="empty-state">
                                        <i class="fas fa-inbox d-block mb-2"></i>
                                        Không có dữ liệu phù hợp với bộ lọc hiện tại.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card card-custom">
        <div class="card-header bg-white">
            <div class="font-weight-bold">
                <i class="fas fa-redo-alt text-warning mr-1"></i>
                Đề xuất học lại môn rớt
            </div>
            <div class="text-muted small">
                Danh sách môn rớt và lớp học phần gợi ý đang/sắp mở trong hệ thống.
            </div>
        </div>

        <div class="card-body">
            @if (Model.DanhSachMonHocLai.Any())
            {
                <div class="row">
                    @foreach (var mon in Model.DanhSachMonHocLai)
                    {
                        <div class="col-lg-4 col-md-6 mb-3">
                            <div class="border rounded p-3 h-100">
                                <div class="font-weight-bold text-danger">
                                    @mon.MaMon - @mon.TenMon
                                </div>

                                <div class="text-muted small">
                                    @mon.Mssv - @mon.HoTen
                                </div>

                                <div class="mt-2">
                                    <span class="badge badge-light border">@mon.SoTinChi tín chỉ</span>
                                    <span class="badge badge-danger">
                                        Điểm @(mon.DiemTongKet?.ToString("0.0") ?? "-")
                                    </span>
                                </div>

                                <hr />

                                @if (mon.LopHocPhanGoiY.Any())
                                {
                                    foreach (var lhp in mon.LopHocPhanGoiY)
                                    {
                                        <div class="bg-light border rounded p-2 mb-2">
                                            <div class="d-flex justify-content-between">
                                                <strong class="text-primary">@lhp.MaLhp</strong>
                                                <span class="badge badge-success">
                                                    Còn @lhp.SoChoConLai/@lhp.SiSoToiDa
                                                </span>
                                            </div>
                                            <div class="text-muted small">@lhp.TenHocKy</div>
                                            <div class="text-muted small">@lhp.LichHoc</div>
                                            @if (!string.IsNullOrWhiteSpace(lhp.PhongHoc))
                                            {
                                                <div class="text-muted small">Phòng: @lhp.PhongHoc</div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-light border mb-0">
                                        Chưa có lớp học phần phù hợp.
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    Chưa có môn rớt cần đề xuất học lại.
                </div>
            }
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const chartLabels = [
        'Bình thường',
        'Cần theo dõi',
        'Cảnh báo học vụ',
        'Nguy cơ học vụ',
        'Chưa đủ dữ liệu'
    ];

    const chartData = [
        @Model.SoBinhThuong,
        @Model.SoCanTheoDoi,
        @Model.SoCanhBaoHocVu,
        @Model.SoNguyCoHocVu,
        @Model.SoChuaDuDuLieu
    ];

    const chartColors = [
        '#22c55e',
        '#06b6d4',
        '#f59e0b',
        '#ef4444',
        '#64748b'
    ];

    const pieCanvas = document.getElementById('chartCanhBaoPie');
    const barCanvas = document.getElementById('chartCanhBaoBar');

    if (pieCanvas) {
        new Chart(pieCanvas, {
            type: 'doughnut',
            data: {
                labels: chartLabels,
                datasets: [{
                    data: chartData,
                    backgroundColor: chartColors,
                    borderWidth: 2,
                    borderColor: '#ffffff'
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    }
                },
                cutout: '62%'
            }
        });
    }

    if (barCanvas) {
        new Chart(barCanvas, {
            type: 'bar',
            data: {
                labels: chartLabels,
                datasets: [{
                    label: 'Số sinh viên',
                    data: chartData,
                    backgroundColor: chartColors,
                    borderRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: false
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });
    }
</script>