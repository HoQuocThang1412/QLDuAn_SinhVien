@model IEnumerable<QuanLySinhVien.Models.LopHocPhan>
@{
    ViewData["Title"] = "Danh sách lớp giảng dạy";
}

<div class="card card-outline card-primary shadow-sm">
    <div class="card-header">
        <h3 class="card-title font-weight-bold"><i class="fas fa-chalkboard-teacher mr-2"></i> Lớp học phần đang phụ trách</h3>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle">
                <thead class="bg-primary text-white text-center">
                    <tr>
                        <th style="width: 15%;">Mã LHP</th>
                        <th class="text-left">Môn học</th>
                        <th style="width: 20%;">Học kỳ</th>
                        <th style="width: 15%;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center font-weight-bold text-primary">@item.MaLhp</td>
                                <td class="text-left"><strong>@item.MaMonNavigation?.TenMon</strong></td>
                                <td class="text-center">
                                    <span class="badge badge-info px-2 py-1">@item.MaHocKy</span>
                                </td>
                                <td class="text-center">
                                    <a href="/Diem/NhapDiem?maLhp=@item.MaLhp"
                                           class="btn btn-primary btn-sm shadow-sm">
                                        <i class="fas fa-edit mr-1"></i> Nhập điểm
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted font-italic">
                                <i class="fas fa-info-circle mr-1"></i> Bạn chưa có lịch phụ trách lớp học phần nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>